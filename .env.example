# ==============================================================================
# PATIMA ENVIRONMENT CONFIGURATION CONTRACT
# ==============================================================================
# Local development / release gate (Docker PostgreSQL 16):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patima_dev"
#
# Production / staging (Neon PostgreSQL direct connection):
# DATABASE_URL="postgresql://<user>:<password>@<ep-name>.neon.tech/neondb?sslmode=require"
#
# The real DATABASE_URL must never be committed. Use .env.local locally and
# Vercel Environment Variables for hosted environments.
# ===============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patima_dev"
NODE_ENV="development"
