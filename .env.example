# ==============================================================================
# PATIMA ENVIRONMENT CONFIGURATION CONTRACT
# ==============================================================================
# Local development / release gate (Docker PostgreSQL 16):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patima_dev"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/patima_dev"
#
# Production / staging (Neon):
# DATABASE_URL="postgresql://<user>:<password>@<ep-name>-pooler.<region>.aws.neon.tech/neondb?sslmode=verify-full"
# DIRECT_URL="postgresql://<user>:<password>@<ep-name>.<region>.aws.neon.tech/neondb?sslmode=verify-full"
#
# DATABASE_URL is used by the Vercel runtime. DIRECT_URL is used only by
# migrations, deterministic seeds, and operations that explicitly require
# direct/session semantics. Never commit real credentials.
#
# Evidence Coach (optional):
# GEMINI_API_KEY="your-key"
# PATIMA_EVIDENCE_COACH_MODEL="gemini-2.5-flash"
# Without GEMINI_API_KEY, PATIMA uses a deterministic local fallback and the
# assessment/evidence path remains fully functional.
# ===============================================================================

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patima_dev"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/patima_dev"
NODE_ENV="development"
